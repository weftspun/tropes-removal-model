    title: "ASD-STE100 Simplified Technical English"
    authors:
      - name: "ASD STE Maintenance Group (STEMG)"
    url: "https://asd-ste100.org"
  - type: software
    title: "SetFit: Efficient Few-Shot Learning Without Prompts"
